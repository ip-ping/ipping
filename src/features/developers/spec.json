    {
      "method": "POST",
      "path": "/api/v1/measurements",
      "summary": "Create Measurement",
      "description": "",
      "parameters": [],
      "body": {
        "required": true,
        "schema": {
          "type": "object",
          "properties": {
            "count": {
              "type": "integer",
              "description": "ping and tcp: probes per node. traceroute: how many times to trace the route (default 1; more shows the loss at each hop, like mtr)",
              "minimum": 1,
              "maximum": 10,
              "nullable": true
            },
            "countries": {
              "type": "array",
              "description": "Limit to nodes in these ISO 3166 countries",
              "maxItems": 300,
              "items": {
                "type": "string"
              },
              "nullable": true
            },
            "dns_mode": {
              "type": "string",
              "enum": [
                "fixed",
                "regional"
              ],
              "default": "regional",
              "description": "regional (the default): each node resolves the hostname itself, so each gets the address that is near it. fixed: resolve it once and have every node probe the same address; `resolve_node_id` says which node resolves it (without one, the backend does)."
            },
            "family": {
              "type": "string",
              "enum": [
                "auto",
                "4",
                "6"
              ],
              "default": "auto"
            },
            "follow_redirects": {
              "type": "boolean",
              "default": false,
              "description": "http only: follow redirects (up to the deployment's limit)"
            },
            "include_community": {
              "type": "boolean",
              "default": false,
              "description": "Also use community nodes (run by volunteers; their results are not verified). Without this, \"all nodes\" means the official ones; choosing a node by id is a choice."
            },
            "kind": {
              "type": "string",
              "enum": [
                "ping",
                "tcp",
                "http",
                "traceroute",
                "dns",
                "tls"
              ],
              "default": "ping",
              "description": "ping: ICMP echo. tcp: time to open a TCP connection to `port`. http: one request, with timings and the TLS certificate. traceroute: the routers on the way. dns: ask each node's resolver (or a public one) about a name and compare the answers. tls: a TLS handshake with no request after it, and what the certificate says."
            },
            "node_ids": {
              "type": "array",
              "description": "Limit to these nodes; omit for all eligible",
              "maxItems": 1000,
              "items": {
                "type": "string"
              },
              "nullable": true
            },
            "port": {
              "type": "integer",
              "description": "Destination port of a tcp or tls check. It can also be given as host:port or in a URL. An http check takes its port from the URL.",
              "minimum": 1,
              "maximum": 65535,
              "nullable": true
            },
            "record_type": {
              "type": "string",
              "enum": [
                "A",
                "AAAA",
                "CNAME",
                "MX",
                "NS",
                "TXT",
                "SOA"
              ],
              "description": "dns only: the record type to ask for (default A)",
              "nullable": true
            },
            "resolve_node_id": {
              "type": "string",
              "description": "With dns_mode fixed and a hostname: the node that resolves it (an online node that can run DNS checks; any tier, since choosing it is a choice). Every node then probes the address that node got. Ignored for an IP address; refused for a dns check and with dns_mode regional.",
              "maxLength": 32,
              "nullable": true
            },
            "resolver": {
              "type": "string",
              "enum": [
                "system",
                "cloudflare",
                "google",
                "quad9"
              ],
              "description": "dns only: system asks each node's own resolvers (what people near the node get); the others ask that public resolver from every node (default system)",
              "nullable": true
            },
            "target": {
              "type": "string",
              "description": "IP address, hostname or URL",
              "minLength": 1,
              "maxLength": 2048
            },
            "transport": {
              "type": "string",
              "enum": [
                "udp",
                "doh",
                "tcp",
                "quic"
              ],
              "description": "dns: udp (the default) or doh, DNS over HTTPS (cloudflare, google and quad9; not the nodes' own resolvers; quad9 answers only over HTTP/2, which nodes speak from v0.7.0). tls: tcp (the default) or quic, a QUIC handshake offering h3 over UDP",
              "nullable": true
            }
          },
          "required": [
            "target"
          ]
        }
      },
      "responses": [
        {
          "status": "201",
          "description": "Successful Response",
          "contentType": "application/json"
        }
      ]
    },
