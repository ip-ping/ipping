# Copy to .env. `docker compose` and the installer read it.

# Required: password for the bundled PostgreSQL (the installer generates one for you).
POSTGRES_PASSWORD=

# One-time token that protects the first-run /setup page. Leave empty to have the backend generate
# one and print it in its log (docker compose logs backend).
IPPING_SETUP_TOKEN=

# Public address. ":80" serves plain HTTP; a domain name makes Caddy fetch a TLS certificate
# (ports 80 and 443 must then be reachable from the internet).
IPPING_SITE_ADDRESS=:80
IPPING_PUBLIC_URL=
# Set to true when serving HTTPS (browsers do not keep Secure cookies over plain HTTP).
IPPING_COOKIE_SECURE=false

# Backend processes (each one is a full instance; they cooperate through PostgreSQL). One is plenty
# for most sites; raise it to use more CPU cores or to survive a worker crash without a pause.
IPPING_BACKEND_WORKERS=1

# Host ports for the proxy.
IPPING_HTTP_PORT=80
IPPING_HTTPS_PORT=443

# Override to pin or test other images.
#IPPING_FRONTEND_IMAGE=tonyliuzj/ipping:latest
#IPPING_BACKEND_IMAGE=tonyliuzj/ipping-backend:latest
